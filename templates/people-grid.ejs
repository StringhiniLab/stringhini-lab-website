```{=html}
<div class="list grid">
  <% for (let item of items) { %>
    <div class="card g-col-12 g-col-sm-6 g-col-md-4 h-100 text-center shadow-sm">
      <% if (item.image) { %>
        <img src="<%= item.image %>" class="card-img-top rounded-circle mx-auto mt-4" style="width: 160px; height: 160px; object-fit: cover;" alt="<%= item.title %>">
      <% } %>
      <div class="card-body d-flex flex-column">
        <h5 class="card-title mb-1">
          <% if (item.url) { %>
            <a href="<%= item.url %>" target="_blank" rel="noopener noreferrer" class="text-decoration-none"><%= item.title %></a>
          <% } else { %>
            <%= item.title %>
          <% } %>
        </h5>
        <h6 class="card-subtitle mb-3 text-muted"><%= item.subtitle %></h6>
        
        <% if (item.bio) { %>
          <div class="mt-auto pt-2">
            <details class="text-start small">
              <summary class="text-primary fw-semibold" style="cursor: pointer; user-select: none;">Read Bio</summary>
              <div class="mt-2 text-muted" style="line-height: 1.4; white-space: pre-line;">
                <%= item.bio %>
              </div>
            </details>
          </div>
        <% } %>
      </div>
    </div>
  <% } %>
</div>
```